{
  "schema": "hydrapy-session-1",
  "name": "Drawn voice — first session",
  "bpm": 120,
  "beats": 8,
  "routes": {
    "picture": {
      "host": "127.0.0.1", "port": 57130,
      "reset": [{"address": "/voice/level", "args": [0]}]
    },
    "pd": {
      "host": "127.0.0.1", "port": 57131,
      "reset": [{"address": "/voice/gate", "args": [0]}]
    }
  },
  "events": [
    {"beat": 0, "route": "picture", "address": "/voice/level", "args": [0.4]},
    {"beat": 0, "route": "picture", "address": "/voice/pitch", "args": [0], "duration": 1},
    {"beat": 0, "route": "picture", "address": "/voice/grit", "args": [0.05], "duration": 4},
    {"beat": 0, "route": "pd", "address": "/voice/gate", "args": [1], "duration": 0.5, "kind": "trigger"},
    {"beat": 0.5, "route": "pd", "address": "/voice/gate", "args": [0]},
    {"beat": 1, "route": "picture", "address": "/voice/pitch", "args": [0.5833333333], "duration": 1},
    {"beat": 2, "route": "picture", "address": "/voice/pitch", "args": [1], "duration": 1},
    {"beat": 3, "route": "picture", "address": "/voice/pitch", "args": [1.5833333333], "duration": 1},
    {"beat": 4, "route": "picture", "address": "/voice/pitch", "args": [2], "duration": 1},
    {"beat": 4, "route": "picture", "address": "/voice/grit", "args": [0.3], "duration": 4},
    {"beat": 4, "route": "pd", "address": "/voice/gate", "args": [1], "duration": 0.5, "kind": "trigger"},
    {"beat": 4.5, "route": "pd", "address": "/voice/gate", "args": [0]},
    {"beat": 5, "route": "picture", "address": "/voice/pitch", "args": [1.5833333333], "duration": 1},
    {"beat": 6, "route": "picture", "address": "/voice/pitch", "args": [1], "duration": 1},
    {"beat": 7, "route": "picture", "address": "/voice/pitch", "args": [0.5833333333], "duration": 1}
  ],
  "processes": [
    {"name": "pd-monitor", "argv": ["pd", "-nogui", "-noaudio", "-open", "osc-monitor.pd"]}
  ]
}
